# ============================================
# Gemini / Google AI API Key (BẮT BUỘC)
# Lấy tại: https://aistudio.google.com/apikey
# ============================================
GEMINI_API_KEY=your_key_here

# ============================================
# Backend Server
# ============================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
UVICORN_RELOAD=true

# ============================================
# Auth (JWT) + Admin mặc định
# ============================================
JWT_SECRET=doi-chuoi-bi-mat-nay-trong-production-toi-thieu-32-ky-tu
JWT_EXPIRE_HOURS=72
ADMIN_EMAIL=admin@medrag.local
ADMIN_PASSWORD=admin123

ENABLE_DEID=true
ENABLE_GRAPH=true
ENABLE_RERANKER=true
ENABLE_FACTCHECK=true

# ============================================
# Knowledge Graph Backend
# "neo4j" : Kết nối Neo4j qua Docker (chuẩn Production / Dev nghiêm ngặt, fail-fast nếu mất kết nối)
# "mock"  : Dùng đồ thị in-memory seed (cho Unit Test, CI/CD, hoặc Offline Dev không cần Docker)
# "none"  : Tắt hoàn toàn tầng GraphRAG
# ============================================
GRAPH_BACKEND=neo4j
# Mặc định false: không tự fallback ngầm để tránh che giấu lỗi hạ tầng
GRAPH_INMEMORY_FALLBACK=false

# ============================================
# Models
# ============================================
DEFAULT_MODEL=gemini-3.5-flash
# Mức suy nghĩ Gemini 3.x (minimal|low|medium|high, để trống = mặc định model là high)
THINKING_LEVEL=low
THINKING_LEVEL_CHITCHAT=minimal
EMBEDDING_MODEL_NAME=keepitreal/vietnamese-sbert
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Reranker: onnx (int8, nhanh trên CPU) | torch (fp32 gốc, để so sánh)
RERANKER_BACKEND=onnx
# Số token tối đa mỗi cặp (câu hỏi, đoạn văn); bản cũ dùng 512
RERANKER_MAX_LENGTH=256
# Số luồng CPU cho onnxruntime (0 = tự chọn)
RERANKER_THREADS=0

# ============================================
# Retrieval tuning
# ============================================
VECTOR_TOP_K=8
BM25_TOP_K=8
FUSED_TOP_K=8
FINAL_TOP_K=5

# ============================================
# Hiệu năng
# ============================================
# Nạp sẵn embedding/reranker/BM25 lúc khởi động
ENABLE_WARMUP=true
# In thời gian từng tầng ra log mỗi câu hỏi
LOG_TIMINGS=true

# ============================================
# Neo4j Knowledge Graph (docker compose up -d neo4j)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medicalrag
NEO4J_DATABASE=neo4j
